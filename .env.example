# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# BMI_SESSION_SECRET: Minimum 32-character secret key used by server.ts to sign HMAC-SHA256 session tokens.
# REQUIRED in production (server will fail-fast if missing or shorter than 32 chars in production).
BMI_SESSION_SECRET="replace-with-at-least-32-chars-random-secret-key-for-production"

# BMI_EXTERNAL_API_URL & BMI_EXTERNAL_API_KEY: Optional HTTPS backend API URL when forwarding state
BMI_EXTERNAL_API_URL=""
BMI_EXTERNAL_API_KEY=""
# Optional comma-separated allowlist of external adapter hostnames (SSRF protection)
BMI_ALLOWED_ADAPTER_HOSTS=""

# Google Sheets Sync Configuration (Server-Side)
GOOGLE_SERVICE_ACCOUNT_JSON=""
BMI_SPREADSHEET_ID="1LVPzTUXrT2HLNbQDNRPh5kzW0dFyBKyLnMuVhscRjT4"

# Frontend / Portfolio Demo Mode (set to "true" for public portfolio 1-click demo & anonymized seed)
VITE_DEMO_MODE="false"

# Optional Server-Side Gemini AI Key (NEVER exposed to client bundle)
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
